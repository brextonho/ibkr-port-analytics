# Copy to .env (gitignored) and fill in. Needed for live pulls only; loading
# downloaded XML files works without it.

# IBKR Client Portal → Settings → Account Report → Flex Web Service
FLEX_TOKEN=
# the number next to your Flex query in Performance & Reports → Flex Queries
FLEX_QUERY_ID=
# optional: warns if a statement belongs to a different account
IBKR_ACCOUNT_ID=
