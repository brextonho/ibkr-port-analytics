# Copy to .env (gitignored) and fill in.

# IBKR Flex Web Service — the only IB secret in the system (PRD §3.2)
FLEX_TOKEN=
FLEX_QUERY_ID=
IBKR_ACCOUNT_ID=

# Postgres (docker-compose) — from the host use localhost:5432,
# from inside a compose container use postgres:5432
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
POSTGRES_PASSWORD=portfolio

# SMTP notifier (Gmail app password), only needed when notifications.backend=smtp
SMTP_USER=
SMTP_PASSWORD=
